/**
 * @file version.hpp
 * @brief Library version (generated by CMake from the VERSION file; do not edit).
 * @ingroup core
 */
#pragma once

/// @brief Major version of dynG. @ingroup core
#define DYNG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
/// @brief Minor version of dynG. @ingroup core
#define DYNG_VERSION_MINOR @PROJECT_VERSION_MINOR@
/// @brief Patch version of dynG. @ingroup core
#define DYNG_VERSION_PATCH @PROJECT_VERSION_PATCH@
/// @brief Full version string as written in the VERSION file (PEP 440, e.g. "0.1.0.dev0"). @ingroup core
#define DYNG_VERSION_STRING "@DYNG_VERSION_STRING@"
/// @brief Single integer for comparisons: MAJOR * 10000 + MINOR * 100 + PATCH. @ingroup core
#define DYNG_VERSION (DYNG_VERSION_MAJOR * 10000 + DYNG_VERSION_MINOR * 100 + DYNG_VERSION_PATCH)

namespace dyng {

/**
 * @brief Version of the library the program was compiled against (the header version).
 * @ingroup core
 */
struct version_info {
  int major_version;   ///< DYNG_VERSION_MAJOR (not `major`: glibc may define a macro of that name)
  int minor_version;   ///< DYNG_VERSION_MINOR
  int patch_version;   ///< DYNG_VERSION_PATCH
  const char* string;  ///< DYNG_VERSION_STRING
};

/**
 * @brief The version of the headers in use.
 * @return The compile-time version of the dynG headers.
 * @ingroup core
 */
constexpr version_info header_version() noexcept {
  return {DYNG_VERSION_MAJOR, DYNG_VERSION_MINOR, DYNG_VERSION_PATCH, DYNG_VERSION_STRING};
}

/**
 * @brief The version of the compiled library that is linked in.
 *
 * Differs from header_version() only if a program was compiled against one release and linked
 * against another.
 *
 * @return The version the library binary was built with.
 * @ingroup core
 */
version_info library_version() noexcept;

}  // namespace dyng
