#
# Package configuration for find_package(dyng) (PLAN Section 7.6).
#   find_package(dyng 0.1 REQUIRED)
#   target_link_libraries(my_app PRIVATE dyng::dyng)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(dyng_HAS_OPENMP @DYNG_ENABLE_OPENMP@)
set(dyng_HAS_CUDA @DYNG_ENABLE_CUDA@)
set(dyng_SHARED @BUILD_SHARED_LIBS@)

# dyng links OpenMP and the CUDA runtime PRIVATELY; a static libdyng still needs them at link time.
if(dyng_HAS_OPENMP AND NOT dyng_SHARED)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
if(dyng_HAS_CUDA)
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dyng-targets.cmake")

check_required_components(dyng)
