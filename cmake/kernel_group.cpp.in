/// Load the group; a failure is the result of the call that asked.
cudaError_t loaded() noexcept {
  return static_cast<cudaError_t>(group().ensure());
}

/// Load the group for a call that hands the runtime the kernel `*function`, unless a loaded group
/// has the same kernel: the linker keeps one copy of an inline function or template that several
/// groups' objects define (CUB's and Thrust's dispatch functions), so another group's code can run
/// this group's copy, whose kernels (static per translation unit) only this group registers; the
/// call then goes to the loaded group's kernel of the same name (kernel_group::ensure_for()).
cudaError_t loaded_for(const void** function) noexcept {
  return static_cast<cudaError_t>(group().ensure_for(function));
