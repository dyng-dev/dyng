{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "dev",
      "description": "Debug development build (CPU backends): tests on, warnings as errors, budgets on",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_WARNINGS_AS_ERRORS": "ON",
        "DYNG_DEBUG_BUDGETS": "ON",
        "DYNG_BUILD_COMPAT_TOOLS": "ON",
        "DYNG_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "release",
      "description": "Optimized build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "relwithdebinfo",
      "description": "Optimized build with debug info",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "cpu-only",
      "displayName": "cpu-only",
      "description": "CPU backends only (hosted CI, CPU wheel): Release, warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DYNG_ENABLE_CUDA": "OFF",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "asan",
      "description": "Host AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DYNG_ENABLE_CUDA": "OFF",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_SANITIZE": "address;undefined",
        "DYNG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "tsan",
      "description": "Host ThreadSanitizer (OpenMP off: GCC's libgomp is not instrumented, so every OpenMP barrier and reduction would be reported; OpenMP race checks need Archer)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DYNG_ENABLE_CUDA": "OFF",
        "DYNG_ENABLE_OPENMP": "OFF",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_SANITIZE": "thread",
        "DYNG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "fuzz",
      "description": "libFuzzer targets of the readers (Clang only: CXX=clang++; ci/fuzz.sh): libdyng instrumented with fuzzer-no-link + ASan + UBSan, -O1, libstdc++ assertions; only the io-relevant library is built",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1 -fno-sanitize-recover=undefined",
        "BUILD_SHARED_LIBS": "OFF",
        "DYNG_ENABLE_CUDA": "OFF",
        "DYNG_ENABLE_OPENMP": "OFF",
        "DYNG_ALGORITHMS": "sssp",
        "DYNG_BUILD_TESTS": "OFF",
        "DYNG_BUILD_EXAMPLES": "OFF",
        "DYNG_BUILD_TOOLS": "OFF",
        "DYNG_BUILD_TUTORIALS": "OFF",
        "DYNG_INSTALL": "OFF",
        "DYNG_DEBUG_BUDGETS": "OFF",
        "DYNG_BUILD_FUZZERS": "ON",
        "DYNG_SANITIZE": "address;undefined;fuzzer-no-link",
        "DYNG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "parity",
      "displayName": "parity",
      "description": "The originals' flags (-O3, g++ -std=c++17 -fopenmp); the OpenMP performance gates use this preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_BUILD_PARITY_TESTS": "ON",
        "DYNG_BUILD_COMPAT_TOOLS": "ON",
        "DYNG_ENABLE_OPENMP": "ON",
        "DYNG_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "dev-cuda",
      "displayName": "dev-cuda",
      "description": "dev with the CUDA backend for the GPUs of this machine (native architecture)",
      "inherits": "dev",
      "cacheVariables": {
        "DYNG_ENABLE_CUDA": "ON",
        "DYNG_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "release-cuda",
      "displayName": "release-cuda",
      "description": "Optimized build with the CUDA backend for the release architecture list (PLAN 7.8)",
      "inherits": "release",
      "cacheVariables": {
        "DYNG_ENABLE_CUDA": "ON",
        "DYNG_CUDA_ARCHITECTURES": "release"
      }
    },
    {
      "name": "parity-cuda",
      "displayName": "parity-cuda",
      "description": "parity with the CUDA backend: MOSP-CUDA's nvcc flags (-O3 -lineinfo -arch=sm_86); the CUDA performance gates use this preset",
      "inherits": "parity",
      "cacheVariables": {
        "DYNG_ENABLE_CUDA": "ON",
        "DYNG_CUDA_ARCHITECTURES": "86",
        "CMAKE_CUDA_FLAGS_RELEASE": "-O3 -lineinfo -fmad=true"
      }
    },
    {
      "name": "sanitize-cuda",
      "displayName": "sanitize-cuda",
      "description": "Debug CUDA build for compute-sanitizer: -lineinfo, every kernel launch checked and synchronized",
      "inherits": "dev",
      "cacheVariables": {
        "DYNG_ENABLE_CUDA": "ON",
        "DYNG_CUDA_ARCHITECTURES": "native",
        "DYNG_CUDA_LINEINFO": "ON",
        "DYNG_CUDA_DEBUG_SYNC": "ON",
        "DYNG_BUILD_COMPAT_TOOLS": "OFF"
      }
    },
    {
      "name": "ci-cuda13",
      "displayName": "ci-cuda13",
      "description": "Compile-only CI (nvidia/cuda:13.x-devel container, no GPU): release architectures, all instantiations, warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DYNG_ENABLE_CUDA": "ON",
        "DYNG_CUDA_ARCHITECTURES": "release",
        "DYNG_BUILD_TESTS": "ON",
        "DYNG_BUILD_COMPAT_TOOLS": "ON",
        "DYNG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-cuda12",
      "displayName": "ci-cuda12",
      "description": "Compile-only CI (nvidia/cuda:12.x-devel container, no GPU): release architectures, all instantiations, warnings as errors",
      "inherits": "ci-cuda13"
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "parity",
      "configurePreset": "parity"
    },
    {
      "name": "dev-cuda",
      "configurePreset": "dev-cuda"
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda"
    },
    {
      "name": "parity-cuda",
      "configurePreset": "parity-cuda"
    },
    {
      "name": "sanitize-cuda",
      "configurePreset": "sanitize-cuda"
    },
    {
      "name": "ci-cuda13",
      "configurePreset": "ci-cuda13"
    },
    {
      "name": "ci-cuda12",
      "configurePreset": "ci-cuda12"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "filter": {
        "include": {
          "label": "cpu"
        }
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "ASAN_OPTIONS": "allocator_may_return_null=1:detect_leaks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "parity",
      "configurePreset": "parity",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "dev-cuda",
      "configurePreset": "dev-cuda",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "parity-cuda",
      "configurePreset": "parity-cuda",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "sanitize-cuda",
      "configurePreset": "sanitize-cuda",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "cpu-only",
      "steps": [
        {
          "type": "configure",
          "name": "cpu-only"
        },
        {
          "type": "build",
          "name": "cpu-only"
        },
        {
          "type": "test",
          "name": "cpu-only"
        }
      ]
    },
    {
      "name": "dev-cuda",
      "steps": [
        {
          "type": "configure",
          "name": "dev-cuda"
        },
        {
          "type": "build",
          "name": "dev-cuda"
        },
        {
          "type": "test",
          "name": "dev-cuda"
        }
      ]
    }
  ]
}
